{
  "@context": "https://agency.local/tool-contracts/v1",
  "@type": "ToolContract",
  "name": "agency.browser.open",
  "version": "1.0",
  "description": "Open a browser session and navigate to a URL through the contract runtime. Navigation is policy-checked for URL scheme, blocked metadata hosts, and host allowlists.",
  "inputs": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "Optional owned browser session to navigate; omit to create a new session."
      },
      "goal": {
        "type": ["string", "null"],
        "description": "Optional research question or extraction goal."
      },
      "extract_mode": {
        "type": "string",
        "enum": ["auto", "text", "markdown", "article", "html", "none"],
        "default": "auto"
      },
      "keep_open": {
        "type": "boolean",
        "default": false,
        "description": "Keep a live session only when a later browser action must reuse the page; extraction-only opens are transient by default."
      },
      "url": {
        "type": [
          "string",
          "null"
        ],
        "description": "Absolute http or https URL to navigate to."
      },
      "http_credentials_username": {
        "type": [
          "string",
          "null"
        ]
      },
      "http_credentials_password": {
        "type": [
          "string",
          "null"
        ]
      },
      "user_agent": {
        "type": [
          "string",
          "null"
        ]
      },
      "browser_type": {
        "type": [
          "string",
          "null"
        ]
      },
      "mobile": {
        "type": "boolean",
        "default": false
      },
      "viewport_width": {
        "type": "integer",
        "minimum": 320,
        "maximum": 3840,
        "default": 1440
      },
      "viewport_height": {
        "type": "integer",
        "minimum": 240,
        "maximum": 2160,
        "default": 900
      },
      "device_scale_factor": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 3.0,
        "default": 1.0
      },
      "locale": {
        "type": [
          "string",
          "null"
        ]
      },
      "timezone_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "storage_state_path": {
        "type": [
          "string",
          "null"
        ]
      },
      "record_video": {
        "type": "boolean",
        "default": false
      },
      "trace_mode": {
        "type": [
          "string",
          "null"
        ]
      },
      "extra_http_headers": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": {
          "type": "string"
        }
      },
      "proxy_binding": {
        "type": ["string", "null"],
        "description": "Opaque Agency proxy credential binding."
      },
      "runtime_policy": {
        "type": ["object", "null"],
        "description": "Per-open resource preferences. The browser runtime clamps these values to its operator-configured limits.",
        "properties": {
          "session_idle_ttl_seconds": {"type": ["integer", "null"], "minimum": 30, "maximum": 86400},
          "session_maximum_ttl_seconds": {"type": ["integer", "null"], "minimum": 60, "maximum": 604800},
          "max_sessions_per_owner": {"type": ["integer", "null"], "minimum": 1, "maximum": 32},
          "max_sessions_total": {"type": ["integer", "null"], "minimum": 1, "maximum": 128},
          "navigation_timeout_ms": {"type": ["integer", "null"], "minimum": 5000, "maximum": 300000},
          "retry_attempts": {"type": ["integer", "null"], "minimum": 1, "maximum": 3},
          "domain_max_concurrency": {"type": ["integer", "null"], "minimum": 1, "maximum": 16},
          "domain_min_interval_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 60},
          "artifact_retention_seconds": {"type": ["integer", "null"], "minimum": 60, "maximum": 604800}
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "outputs": {
    "type": "object",
    "properties": {
      "verdict": {
        "type": "string",
        "enum": [
          "ok",
          "warn",
          "deny"
        ]
      },
      "policyVerdict": {
        "type": [
          "object",
          "null"
        ]
      },
      "result": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "tool": {
            "type": "string",
            "const": "agency.browser.open"
          },
          "output": {
            "type": [
              "object",
              "string",
              "null"
            ],
            "additionalProperties": true
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "patch": {
        "type": [
          "string",
          "null"
        ]
      },
      "filesChanged": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "dryRun": {
        "type": "boolean"
      },
      "timestamp": {
        "type": "string"
      },
      "actor": {
        "type": [
          "string",
          "null"
        ]
      },
      "signature": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "verdict",
      "dryRun",
      "timestamp"
    ],
    "additionalProperties": false
  }
}
