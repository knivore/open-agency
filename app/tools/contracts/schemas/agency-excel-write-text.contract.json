{
  "@context": "https://agency.local/tool-contracts/v1",
  "@type": "ToolContract",
  "name": "agency.excel.write-text",
  "version": "1.0",
  "description": "Read a text file and write its content into an allowlisted Excel workbook through the Agency policy/runtime layer.",
  "inputs": {
    "type": "object",
    "properties": {
      "sheet_name": {
        "type": "string",
        "description": "Target worksheet name."
      },
      "excel_file_path": {
        "type": "string",
        "description": "Allowlisted Excel workbook path to modify."
      },
      "text_file_path": {
        "type": "string",
        "description": "Allowlisted text file path to read."
      },
      "serial_number": {
        "type": "integer",
        "description": "Row serial number used by the workbook writer."
      },
      "header_title": {
        "type": ["string", "null"],
        "description": "Optional column header title."
      }
    },
    "required": ["sheet_name", "excel_file_path", "text_file_path", "serial_number"],
    "additionalProperties": false
  },
  "outputs": {
    "type": "object",
    "properties": {
      "verdict": {
        "type": "string",
        "enum": ["ok", "warn", "deny"]
      },
      "policyVerdict": {
        "type": ["object", "null"]
      },
      "result": {
        "type": ["object", "null"],
        "additionalProperties": true
      },
      "patch": {
        "type": ["string", "null"]
      },
      "filesChanged": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "dryRun": {
        "type": "boolean"
      },
      "timestamp": {
        "type": "string"
      },
      "actor": {
        "type": ["string", "null"]
      },
      "signature": {
        "type": ["string", "null"]
      }
    },
    "required": ["verdict", "dryRun", "timestamp"],
    "additionalProperties": false
  }
}
