{
  "@context": "https://agency.local/tool-contracts/v1",
  "@type": "ToolContract",
  "name": "agency.browser.analyze-screenshot",
  "version": "1.0",
  "description": "Analyze the current browser screenshot with a visual instruction and return a signed structured result.",
  "inputs": {
    "type": "object",
    "properties": {
      "text": { "type": "string", "minLength": 1, "description": "Instruction or question relating to the current screenshot." }
    },
    "required": ["text"],
    "additionalProperties": false
  },
  "outputs": {
    "type": "object",
    "properties": {
      "verdict": { "type": "string", "enum": ["ok", "warn", "deny"] },
      "policyVerdict": { "type": ["object", "null"] },
      "result": {
        "type": ["object", "null"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "error"] },
          "tool": { "type": "string", "const": "agency.browser.analyze-screenshot" },
          "output": { "type": "string" },
          "error": { "type": "string" }
        },
        "additionalProperties": true
      },
      "patch": { "type": ["string", "null"] },
      "filesChanged": { "type": "array", "items": { "type": "object" } },
      "errors": { "type": "array", "items": { "type": "string" } },
      "dryRun": { "type": "boolean" },
      "timestamp": { "type": "string" },
      "actor": { "type": ["string", "null"] },
      "signature": { "type": ["string", "null"] }
    },
    "required": ["verdict", "dryRun", "timestamp"],
    "additionalProperties": false
  }
}
