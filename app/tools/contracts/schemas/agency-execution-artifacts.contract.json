{
  "@context": "https://agency.local/tool-contracts/v1",
  "@type": "ToolContract",
  "name": "agency.execution.artifacts",
  "version": "1.0",
  "description": "Read Agency execution artifact metadata and optional safe content by execution_id through the contract layer.",
  "inputs": {
    "type": "object",
    "properties": {
      "execution_id": {
        "type": "string",
        "minLength": 1,
        "description": "Execution id whose artifacts should be inspected."
      },
      "include_content": {
        "type": "boolean",
        "default": true
      },
      "max_content_chars": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20000,
        "default": 4000
      }
    },
    "required": [
      "execution_id"
    ],
    "additionalProperties": false
  },
  "outputs": {
    "type": "object",
    "properties": {
      "verdict": {
        "type": "string",
        "enum": [
          "ok",
          "warn",
          "deny"
        ]
      },
      "policyVerdict": {
        "type": [
          "object",
          "null"
        ]
      },
      "result": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      },
      "patch": {
        "type": [
          "string",
          "null"
        ]
      },
      "filesChanged": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "dryRun": {
        "type": "boolean"
      },
      "timestamp": {
        "type": "string"
      },
      "actor": {
        "type": [
          "string",
          "null"
        ]
      },
      "signature": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "verdict",
      "dryRun",
      "timestamp"
    ],
    "additionalProperties": false
  }
}
