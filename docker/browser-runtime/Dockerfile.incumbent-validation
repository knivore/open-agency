# Validation-only image for comparing the pre-unified in-process browser.
# Build it from an isolated checkout of the incumbent revision; never deploy it.
FROM python:3.12-slim-bookworm

WORKDIR /baseline

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-liberation \
        fonts-unifont \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxrandr2 \
        libxshmfence1 \
        libxss1 \
        libxtst6 \
        procps && \
    rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN python -m pip install --no-cache-dir \
    boto3==1.36.8 \
    fastapi==0.115.6 \
    openai==1.59.9 \
    playwright==1.49.1 \
    pydantic==2.10.4 \
    pyyaml==6.0.2 && \
    mkdir -p "$PLAYWRIGHT_BROWSERS_PATH" && \
    python -m playwright install chromium

COPY app /baseline/app

RUN useradd --create-home --uid 10001 browser && \
    mkdir -p /validation && \
    chown -R browser:browser /validation /home/browser

WORKDIR /validation
USER browser

